{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truelend-website",
  "main": ".open-next/worker.js",
  // nodejs_compat + a recent date are required by OpenNext and postgres.js.
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Custom domains — wrangler provisions the DNS record + edge cert on deploy.
  // Requires the truelend.in zone to be active on this Cloudflare account.
  "routes": [
    { "pattern": "truelend.in", "custom_domain": true },
    { "pattern": "www.truelend.in", "custom_domain": true },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Email (Resend). RESEND_API_KEY is a secret (wrangler secret put). EMAIL_FROM
  // must be a verified Resend sender; onboarding@resend.dev works for testing to
  // your own account email. Set TEAM_EMAIL to route new-lead alerts. Empty
  // TEAM_EMAIL / missing key = email is a silent no-op.
  "vars": {
    "EMAIL_FROM": "TrueLend <hello@truelend.in>",
    "TEAM_EMAIL": "shathwik@icloud.com",
  },
  // Postgres (Neon), pooled by Hyperdrive. The id is not a secret — credentials
  // live inside the Hyperdrive config on Cloudflare. For local dev/preview the
  // connection string comes from apps/website/.env via
  // WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (gitignored);
  // localConnectionString below is only the fallback when that env is unset.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "88ae362ffaea4695b72a99731389a543",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/truelend",
    },
  ],
  // Object storage. Create it once: wrangler r2 bucket create truelend
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "truelend",
    },
  ],
}
