{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truelend-website",
  "main": ".open-next/worker.js",
  // nodejs_compat + a recent date are required by OpenNext and postgres.js.
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  // Custom domains — wrangler provisions the DNS record + edge cert on deploy.
  // Requires the truelend.in zone to be active on this Cloudflare account.
  "routes": [
    { "pattern": "truelend.in", "custom_domain": true },
    { "pattern": "www.truelend.in", "custom_domain": true },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Backs next/image's optimizer. Without it every optimized-image request
  // falls back to serving the original, unresized asset.
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Email (Resend). RESEND_API_KEY is a secret (wrangler secret put). EMAIL_FROM
  // must be a verified Resend sender; onboarding@resend.dev works for testing to
  // your own account email. TEAM_EMAIL receives new-lead alerts and must stay a
  // monitored role mailbox — those alerts carry applicant contact details. Local
  // development may omit delivery; production preflight requires the API key.
  "vars": {
    "EMAIL_FROM": "TrueLend <hello@truelend.in>",
    "TEAM_EMAIL": "loans@truelend.in",
    // A lead arriving through a ?ref= link notifies the Referral Partner who
    // sourced it, so this worker sends partner-facing mail too. Without it
    // partnerSender() falls back to EMAIL_FROM and the message goes out under
    // the wrong identity — same value as the admin and partners workers.
    "PARTNER_EMAIL": "TrueLend Referral Partners <partner@truelend.in>",
  },
  // Postgres (Neon), pooled by Hyperdrive. The id is not a secret — credentials
  // live inside the Hyperdrive config on Cloudflare. For local dev/preview the
  // connection string comes from apps/website/.dev.vars via
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (gitignored);
  // localConnectionString below is only the fallback when that env is unset.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "88ae362ffaea4695b72a99731389a543",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/truelend",
    },
  ],
}
