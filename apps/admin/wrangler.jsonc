{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truelend-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  // Custom domain — wrangler provisions the DNS record + edge cert on deploy.
  "routes": [{ "pattern": "admin.truelend.in", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    // Overridden to http://localhost:3001 in .dev.vars for local dev.
    "BETTER_AUTH_URL": "https://admin.truelend.in",
    // Email (Resend). RESEND_API_KEY is a secret. EMAIL_FROM must be a verified
    // sender; TEAM_EMAIL receives new-lead alerts. PARTNERS_URL links the
    // partner in verified/rejected emails. Missing key = no-op.
    "EMAIL_FROM": "TrueLend <hello@truelend.in>",
    "TEAM_EMAIL": "shathwik@icloud.com",
    "PARTNERS_URL": "https://partner.truelend.in",
  },
  // Same account-level Hyperdrive config the website uses (shared Neon pool).
  // Secrets (wrangler secret put / .dev.vars): BETTER_AUTH_SECRET.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "88ae362ffaea4695b72a99731389a543",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/truelend",
    },
  ],
  // Read-only here: partners upload KYC docs to this bucket; admin serves them
  // back through an authenticated route.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "truelend",
    },
  ],
}
