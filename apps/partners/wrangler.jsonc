{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truelend-partners",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  // Custom domain — wrangler provisions the DNS record + edge cert on deploy.
  "routes": [{ "pattern": "partner.truelend.in", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      // Shared with admin so the same credential cannot bypass the limit by host.
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "PARTNER_WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "vars": {
    // Overridden to http://localhost:3002 in .dev.vars for local dev.
    "BETTER_AUTH_URL": "https://partner.truelend.in",
    // A site key is public. Pass it at runtime so the registration form can
    // render Turnstile after the Worker is deployed.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD0gmfEKR5XdzhJR",
    // Email (Resend). RESEND_API_KEY is a secret; TEAM_EMAIL receives Referral Partner
    // lead alerts. Local development may omit delivery; production preflight
    // requires the API key.
    "EMAIL_FROM": "TrueLend Referral Partners <partner@trulend.in>",
    "TEAM_EMAIL": "shathwik@icloud.com",
  },
  // Same account-level Hyperdrive config (shared Neon pool) the other apps use.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "88ae362ffaea4695b72a99731389a543",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/truelend",
    },
  ],
  // KYC document storage — same bucket the admin app reads from.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "truelend",
    },
  ],
}
