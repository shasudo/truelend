{
  "name": "@truelend/partners",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node ../../scripts/assert-build-env-safe.mjs partners && next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "worker:build": "node ../../scripts/assert-build-env-safe.mjs partners && opennextjs-cloudflare build",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy-bundle --config wrangler.jsonc",
    "worker:deploy": "opennextjs-cloudflare deploy",
    "deploy": "pnpm worker:build && pnpm worker:deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:validate": "wrangler types /tmp/truelend-partners-env.d.ts --env-interface CloudflareEnv --include-runtime false --env-file /dev/null",
    "lint": "eslint .",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@truelend/auth": "workspace:*",
    "@truelend/db": "workspace:*",
    "@truelend/email": "workspace:*",
    "@truelend/health": "workspace:*",
    "@truelend/reference": "workspace:*",
    "@truelend/turnstile": "workspace:*",
    "@truelend/types": "workspace:*",
    "@truelend/ui": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "papaparse": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@opennextjs/cloudflare": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@truelend/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/papaparse": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
