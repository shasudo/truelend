{
  "name": "@truelend/partners",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node ../../scripts/assert-build-env-safe.mjs partners && next build",
    "start": "next start",
    "preview": "node ../../scripts/preview-worker.mjs partners",
    "worker:build": "node ../../scripts/assert-build-env-safe.mjs partners && opennextjs-cloudflare build",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy-bundle --config wrangler.jsonc",
    "worker:deploy": "node ../../scripts/assert-production-deploy.mjs && opennextjs-cloudflare deploy",
    "worker:verify": "pnpm worker:build && pnpm worker:dry-run && node ../../scripts/scan-worker-bundle.mjs partners .wrangler/deploy-bundle",
    "deploy": "node ../../scripts/assert-production-deploy.mjs && pnpm worker:build && opennextjs-cloudflare deploy",
    "cf-typegen": "node ../../scripts/check-cloudflare-types.mjs partners --write",
    "cf:validate": "node ../../scripts/check-cloudflare-types.mjs partners",
    "lint": "eslint .",
    "test": "tsx --test --experimental-test-module-mocks test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@truelend/auth": "workspace:*",
    "@truelend/db": "workspace:*",
    "@truelend/email": "workspace:*",
    "@truelend/health": "workspace:*",
    "@truelend/reference": "workspace:*",
    "@truelend/turnstile": "workspace:*",
    "@truelend/ui": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@opennextjs/cloudflare": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@truelend/eslint-config": "workspace:*",
    "@truelend/test-support": "workspace:*",
    "@truelend/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
